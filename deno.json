{
  "nodeModulesDir": "auto",
  "tasks": {
    "dev": {
      "command": "deno run -A npm:vite --host",
      "description": "Start the server"
    },
    "build": {
      "command": "deno run -A npm:vite build",
      "description": "Build the app"
    },
    "preview": {
      "command": "deno run -A npm:vite preview",
      "description": "Preview the build locally",
      "dependencies": ["build"]
    },
    "serve": {
      "command": "deno run --allow-net --allow-read jsr:@std/http@1/file-server dist/",
      "description": "Serve the build using Deno file server",
      "dependencies": ["build"]
    },
    "update": {
      "command": "deno outdated --update --latest --interactive",
      "description": "Update the selected packages"
    }
  },
  "imports": {
    "@vitejs/plugin-vue": "npm:@vitejs/plugin-vue@6.0.7",
    "jwt-decode": "npm:jwt-decode@4.0.0",
    "oxfmt": "npm:oxfmt@0.52.0",
    "oxlint": "npm:oxlint@1.67.0",
    "sass-embedded": "npm:sass-embedded@1.100.0",
    "typescript": "npm:typescript@6.0.3",
    "vite": "npm:vite@8.0.14",
    "vite-plugin-checker": "npm:vite-plugin-checker@0.14.1",
    "vite-plugin-oxlint": "npm:vite-plugin-oxlint@2.1.1",
    "vue": "npm:vue@3.5.35",
    "vue-router": "npm:vue-router@5.1.0",
    "vue-tsc": "npm:vue-tsc@3.3.3"
  },
  "lint": {
    "rules": {
      "exclude": ["no-sloppy-imports"]
    }
  }
}
